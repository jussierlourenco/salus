{
  "forbidden": [
    {
      "name": "no-circular-dependencies",
      "severity": "error",
      "from": {
        "path": "^src"
      },
      "to": {
        "path": "^src",
        "circular": true
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "node_modules"
    },
    "exclude": {
      "path": "(node_modules|dist|build)"
    }
  }
}
