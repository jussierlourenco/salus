rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todo dado do Salus App vive sob /usuarios/{uid}/... — dono do uid é o único
    // que pode ler ou escrever qualquer documento na própria árvore.
    // Ver docs/app-aistudio/00_ARQUITETURA.md §4.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nenhuma coleção fora deste padrão é permitida.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
