rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todo dado do Salus App vive sob /usuarios/{uid}/... — dono do uid é o único
    // que pode ler ou escrever qualquer documento na própria árvore.
    // Ver docs/app-aistudio/00_ARQUITETURA.md §4.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Coleção de administração de usuários
    // - Qualquer auth pode criar seu próprio documento (self-register)
    // - Qualquer auth pode ler seu próprio documento (verificar status)
    // - Apenas o super-admin (jussier.silva@gmail.com) pode listar/todos e atualizar status
    match /admin_usuarios/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.email == 'jussier.silva@gmail.com'
      );
      allow write: if request.auth != null && (
        request.auth.token.email == 'jussier.silva@gmail.com'
      );
    }

    // Nenhuma coleção fora dos padrões acima é permitida.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
