rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNÇÕES AUXILIARES =====
    function isSignedIn() {
      return request.auth != null;
    }
    function familiaDoc(familiaId) {
      return /databases/$(database)/documents/familias/$(familiaId);
    }
    function membroDoc(familiaId, membroId) {
      return /databases/$(database)/documents/familias/$(familiaId)/membros/$(membroId);
    }
    function isFamiliaMember(familiaId) {
      return isSignedIn() &&
        request.auth.uid in get(familiaDoc(familiaId)).data.membros_uids;
    }
    function isMembroShared(familiaId, membroId) {
      return request.auth.uid in get(membroDoc(familiaId, membroId)).data.compartilhado_com_uids;
    }

    // ===== DOC DA FAMÍLIA (inalterado) =====
    match /familias/{familiaId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.membros_uids;
      allow create: if isSignedIn() && request.resource.data.membros_uids == [request.auth.uid];
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.membros_uids ||
        (
          !(request.auth.uid in resource.data.membros_uids) &&
          request.resource.data.membros_uids == resource.data.membros_uids.concat([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros_uids', 'atualizado_em'])
        )
      );
      allow delete: if false;
    }

    // ===== SUBCOLEÇÕES — regras por coleção (sem wildcard) =====

    // MEMBROS — leitura para família OU usuários no compartilhado_com_uids
    match /familias/{familiaId}/membros/{membroId} {
      allow read: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['compartilhado_com_uids']) &&
         request.auth.uid in resource.data.compartilhado_com_uids)
      );
      allow create: if isFamiliaMember(familiaId);
      allow update: if isFamiliaMember(familiaId);
      allow delete: if isFamiliaMember(familiaId);
    }

    // MEDICAMENTOS — acesso via família OU compartilhamento do membro associado
    match /familias/{familiaId}/medicamentos/{id} {
      allow read: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
      allow create, update: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (request.resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, request.resource.data.membro_id))
      );
      allow delete: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
    }

    // EXAMES
    match /familias/{familiaId}/exames/{id} {
      allow read: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
      allow create, update: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (request.resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, request.resource.data.membro_id))
      );
      allow delete: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
    }

    // VACINAS
    match /familias/{familiaId}/vacinas/{id} {
      allow read: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
      allow create, update: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (request.resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, request.resource.data.membro_id))
      );
      allow delete: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
    }

    // EVENTOS
    match /familias/{familiaId}/eventos/{id} {
      allow read: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
      allow create, update: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (request.resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, request.resource.data.membro_id))
      );
      allow delete: if isSignedIn() && (
        isFamiliaMember(familiaId) ||
        (resource.data.keys().hasAll(['membro_id']) &&
         isMembroShared(familiaId, resource.data.membro_id))
      );
    }

    // CAIXA DE ENTRADA — apenas membros da família (sem membro_id para granularidade)
    match /familias/{familiaId}/caixa_entrada/{id} {
      allow read, write: if isFamiliaMember(familiaId);
    }

    // CONFIG — apenas membros da família
    match /familias/{familiaId}/config/{id} {
      allow read, write: if isFamiliaMember(familiaId);
    }

    // ===== COLLECTION GROUP — descoberta de membros compartilhados =====
    match /{path=**}/membros/{membroId} {
      allow read: if isSignedIn() &&
        resource.data.keys().hasAll(['compartilhado_com_uids']) &&
        request.auth.uid in resource.data.compartilhado_com_uids;
    }

    // ===== DADOS LEGADOS (backup, inalterado) =====
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ===== ADMIN =====
    match /admin_usuarios/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        request.auth.token.email == 'jussier.silva@gmail.com'
      );
      allow update: if isSignedIn() && (
        // Usuário pode alterar apenas familia_id no próprio documento
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familia_id'])) ||
        // Admin pode alterar qualquer campo
        request.auth.token.email == 'jussier.silva@gmail.com'
      );
      allow delete: if false;
    }

    // ===== NEGAÇÃO GERAL =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
