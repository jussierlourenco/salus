# Firebase — copie este arquivo para .env.local e preencha com suas credenciais
# Obtenha no Console do Firebase: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Drive — Client ID OAuth 2.0 (não é a chave de IA; cada usuário cadastra a
# própria chave de IA em Ajustes, dentro do app). Passo a passo completo em CONFIGURACAO.md.
VITE_GOOGLE_CLIENT_ID=
